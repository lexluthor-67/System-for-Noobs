def delete_student(username):
    print("=" * width)
    print("-- DELETE STUDENT --".center(width))
    print("=" * width)

    if not grades:
        print("[ NO STUDENT RECORDS AVAILABLE ]".center(width))
        main2(username)
        return

    student_name = input("Enter Student Name to Delete: ")

    if student_name in grades:
        del grades[student_name]
        print()
        print("[ STUDENT DELETED SUCCESSFULLY ]".center(width))
        time.sleep(5)
    else:
        print()
        print("[ STUDENT NOT FOUND ]".center(width))
        time.sleep(5)
    print()
    main2(username)


