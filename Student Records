import time

width = 45
grades = {}


def show_header():
    print("=" * width)
    print("-- WELCOME TO MY SYSTEM --".center(width))
    print("=" * width)



def add_students(username):
    print("=" * width)
    print("-- STUDENT PROFILE --".center(width))
    print("=" * width)

    try:
        quantity = int(input("Enter Student Quantity: "))
        print("-" * width)

        if quantity <= 0:
            print()
            print("-- [ Enter a Valid Quantity! ] --".center(width))
            return

    except ValueError:
        print("[ ENTER NUMBERS ONLY! ] --".center(width))
        return

    for i in range(quantity):
        print()

        student_name = input("Enter Student Name  : ")

        if not student_name:
            print("[ STUDENT NAME CANNOT BE EMPTY! ]".center(width))
            continue  # CHANGE 2: Skip empty names

        if student_name in grades:
            print("[ STUDENT ALREADY EXISTS! ]".center(width))
            continue  # CHANGE 3: Skip duplicate names

        try:
            student_grade = float(input("Enter Student Grade : "))

            if student_grade < 0 or student_grade > 100:
                print("[ GRADE MUST BE FROM 0 TO 100 ]".center(width))
                continue  

            grades[student_name] = student_grade

        except ValueError:
            print()
            print("[ ENTER NUMBERS ONLY! ] --".center(width))
            continue

    print()
    print("OPTIONS:".center(width))
    print("1. Proceed to Overview")
    print("2. Add Student")
    print("3. Return to Main Menu")  
    print()

    try:
        choice2 = int(input("Enter your Choice: "))

        if choice2 < 1 or choice2 > 3:
            print("[ INVALID INPUT ]".center(width))
            return

        if choice2 == 1:
            show_overview(username)  
        elif choice2 == 2:
            add_students(username)  
        elif choice2 == 3:
            return

    except ValueError:
        print("[ INVALID INPUT! ]".center(width))
        return


def show_overview(username):
    print()
    print("=" * width)
    print("-- STUDENT OVERVIEW --".center(width))
    print("=" * width)
    print()

    if not grades:
        print("[ NO STUDENT RECORDS AVAILABLE ]".center(width))
    else:
        for number, (name, grade) in enumerate(grades.items(), start=1):
            print(
                f"{number:2}. NAME: {name:<7} "
                f"----------   GRADE: {grade: .2f}"
            )

    print()
    print("Type 1 to return to Main Menu")

    try:
        choice2 = int(input("Type Here: "))

        if choice2 == 1:
            main2(username)  
        else:
            print("[ INVALID INPUT ]".center(width))
            return

    except ValueError:
        print("[ INVALID INPUT ]".center(width))
        return


